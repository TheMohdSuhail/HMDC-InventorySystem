{
  "name": "herbal-maza-inventory",
  "version": "1.0.0",
  "description": "MySQL-backed inventory, sales and purchasing with admin and user access",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "build:hosted": "node scripts/build-hosted.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/inventory.integration.test.ts tests/buckets.integration.test.ts tests/product-import.integration.test.ts tests/quantity.integration.test.ts tests/batch.integration.test.ts tests/orders.integration.test.ts tests/product-delete.integration.test.ts",
    "test:browser": "node --env-file=.env --import tsx scripts/e2e.ts",
    "test:prepare": "node --env-file=.env --import tsx scripts/prepare-test-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "node --env-file=.env --import tsx scripts/check-integrity.ts",
    "db:backfill-batches": "node --env-file=.env --import tsx scripts/backfill-batches.ts",
    "db:check-batches": "node --env-file=.env --import tsx scripts/reconcile-batches.ts",
    "setup:user": "tsx --env-file=.env scripts/setup-user.ts",
    "reset:password": "tsx --env-file=.env scripts/reset-password.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "read-excel-file": "^9.3.12",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
